<launch>
  <!-- ================================================================
       bench.launch — Mốc M2
       Một lượt chạy thử nghiệm hoàn chỉnh, không cần RViz, không cần
       thao tác tay. batch_runner.py gọi file này lặp đi lặp lại.

       Đặt tại: thesis_tools/benchmark_tools/launch/bench.launch
       ================================================================ -->

  <arg name="map_name" default="I1"/>
  <arg name="config"   default="B0"/>
  <arg name="trial"    default="0"/>
  <arg name="goal_x"   default="5.0"/>
  <arg name="goal_y"   default="0.0"/>
  <arg name="out_csv"  default="$(env HOME)/fast_planner_ws/src/Fast-Planner/results/raw/bench.csv"/>
  <arg name="timeout"  default="120.0"/>
  <arg name="use_pcd"  default="false"/>
  <arg name="map_file" default=""/>

  <!-- Seed cố định cho bản đồ: cùng seed thì cùng bản đồ.
       Trộn map_name vào seed để mỗi bản đồ khác nhau nhưng vẫn tái lập được. -->
  <arg name="map_seed" default="20260908"/>

  <!-- Bật đường ống vật cản động. Để 0 ở mốc M2, sẽ dùng từ M4. -->
  <arg name="dynamic_env" default="0"/>
  
  <!-- [Luan van - M5] Vat can dong. dyn_obs=1 thi obj_generator chay va
       metric_logger do them khoang cach toi vat can dong.
       batch_runner luon truyen ca ba tham so nay. -->
  <arg name="dyn_obs"  default="0"/>
  <arg name="dyn_num"  default="0"/>
  <arg name="dyn_seed" default="1"/>
  <arg name="dyn_avoid" default="0"/>
  <arg name="lambda9"   default="5.0"/>
  <arg name="dist_dyn0" default="0.7"/>
  <arg name="t_dyn_max" default="2.0"/>
  <arg name="thresh_replan" default="1.5"/>
  <arg name="dyn_margin_rate" default="0.0"/>
  <arg name="dyn_static_min" default="0.2"/>
  
  <!-- Kich thuoc ban do va diem xuat phat: doi theo tung ban do Indoor -->
  <arg name="map_size_x" default="40.0"/>
  <arg name="map_size_y" default="20.0"/>
  <arg name="map_size_z" default="5.0"/>
  <arg name="init_x"     default="-19.0"/>
  <arg name="init_y"     default="0.0"/>
  <arg name="init_z"     default="1.0"/>
  <arg name="max_vel"    default="3.0"/>
  <arg name="max_acc"    default="2.0"/>

  <!-- Tham so quet o giai doan 5 -->
  <arg name="map_resolution" default="0.1"/>
  <arg name="ctrl_pt_dist"   default="0.5"/>
  <arg name="w_time"         default="10.0"/>
  <arg name="lambda2"        default="5.0"/>
  <arg name="dist0"          default="0.4"/>
  <arg name="inflation"    default="0.099"/>
  <arg name="local_range"  default="5.5"/>
  <arg name="virtual_ceil" default="2.5"/>

  <!-- [Luan van - M3] pha cat canh (<= 0: tat) -->
  <arg name="takeoff_height"       default="-1.0"/>

  <!-- ===== Hệ thống chính ===== -->
  <!-- Cần đã bổ sung ba tham số map_seed, dynamic_env, flight_type
       vào kino_replan.launch — xem README-M2.md, Bước 2. -->
  <include file="$(find plan_manage)/launch/kino_replan.launch">
    <arg name="map_seed"    value="$(arg map_seed)"/>
    <arg name="dynamic_env" value="$(arg dynamic_env)"/>
    <arg name="flight_type" value="1"/>
    
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="init_x"     value="$(arg init_x)"/>
    <arg name="init_y"     value="$(arg init_y)"/>
    <arg name="init_z"     value="$(arg init_z)"/>
    <arg name="max_vel"    value="$(arg max_vel)"/>
    <arg name="max_acc"    value="$(arg max_acc)"/>

    <arg name="map_resolution" value="$(arg map_resolution)"/>
    <arg name="ctrl_pt_dist"   value="$(arg ctrl_pt_dist)"/>
    <arg name="w_time"         value="$(arg w_time)"/>
    <arg name="lambda2"        value="$(arg lambda2)"/>
    <arg name="dist0"          value="$(arg dist0)"/>
    <arg name="inflation"    value="$(arg inflation)"/>
    <arg name="local_range"  value="$(arg local_range)"/>
    <arg name="virtual_ceil" value="$(arg virtual_ceil)"/>

    <arg name="takeoff_height"       value="$(arg takeoff_height)"/>

    <arg name="use_pcd"  value="$(arg use_pcd)"/>
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="dyn_obs"  value="$(arg dyn_obs)"/>
    <arg name="dyn_num"  value="$(arg dyn_num)"/>
    <arg name="dyn_seed" value="$(arg dyn_seed)"/>
    <arg name="dyn_avoid" value="$(arg dyn_avoid)"/>
    <arg name="lambda9"   value="$(arg lambda9)"/>
    <arg name="dist_dyn0" value="$(arg dist_dyn0)"/>
    <arg name="t_dyn_max" value="$(arg t_dyn_max)"/>
    <arg name="thresh_replan" value="$(arg thresh_replan)"/>
    <arg name="dyn_margin_rate" value="$(arg dyn_margin_rate)"/>
    <arg name="dyn_static_min" value="$(arg dyn_static_min)"/>
  </include>

  <!-- ===== Bộ thu thập chỉ số ===== -->
  <node pkg="benchmark_tools" type="metric_logger.py" name="metric_logger"
        output="screen" required="true">
    <param name="out_csv"    value="$(arg out_csv)"/>
    <param name="map_name"   value="$(arg map_name)"/>
    <param name="config"     value="$(arg config)"/>
    <param name="trial"      value="$(arg trial)"/>
    <param name="goal_x"     value="$(arg goal_x)"/>
    <param name="goal_y"     value="$(arg goal_y)"/>
    <param name="timeout"    value="$(arg timeout)"/>
    <param name="goal_tol"   value="0.6"/>
    <param name="uav_radius" value="0.2"/>
    <!-- Chờ bấy nhiêu giây sau khi bản đồ và odometry sẵn sàng rồi mới
         phát đích. Để hệ thống ổn định, tránh đo cả giai đoạn khởi động. -->
    <param name="goal_delay" value="4.0"/>
    <param name="takeoff_height" value="$(arg takeoff_height)"/>
    <!-- [Luan van - M5] 0 = khong do vat can dong -->
    <param name="dyn_num" value="$(arg dyn_num)"/>
  </node>

</launch>
